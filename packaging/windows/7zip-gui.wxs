<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows installer, built by `cargo xtask package` with WiX 5:

    wix build -arch x64|arm64 -ext WixToolset.UI.wixext
      -d Version=1.2.3 -d Exe=...\7zip-gui.exe -d Stage=... -d Packaging=...\packaging\windows

  The UpgradeCode must never change: it is how a new MSI finds and replaces
  the old version (MajorUpgrade), which the in-app updater relies on.
  File associations are added as "Open with" entries only, so installing
  7zip-GUI never takes over the user's default archive program.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="7zip-GUI"
      Manufacturer="Damien Reichhart"
      Version="$(Version)"
      UpgradeCode="240B12B9-1A8B-483A-973E-7CAC4740378F"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">

    <SummaryInformation Description="7zip-GUI — a desktop interface for 7-Zip" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of 7zip-GUI is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(Packaging)\7zip-gui.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://damienreichhart.github.io/7zip-GUI/docs/" />
    <Property Id="ARPURLINFOABOUT" Value="https://damienreichhart.github.io/7zip-GUI/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://damienreichhart.github.io/7zip-GUI/download/" />
    <Property Id="ARPCOMMENTS" Value="Requires 7-Zip, installed separately." />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(Stage)\License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="7zip-GUI" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="MainExe" Source="$(Exe)" Name="7zip-gui.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Name="7zip-GUI" Description="Open, create and extract archives with 7-Zip"
                    Directory="ProgramMenuFolder" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="yes" />
        </File>

        <!-- `7zip-gui` from Run (Win+R) and `start 7zip-gui`. -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\7zip-gui.exe" Type="string" Value="[#MainExe]" />

        <!-- One programmatic identifier, offered in "Open with" for each archive type. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SevenZipGui.Archive" Type="string" Value="Archive (7zip-GUI)" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SevenZipGui.Archive\DefaultIcon" Type="string" Value="[#MainExe],0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SevenZipGui.Archive\shell\open\command" Type="string" Value="&quot;[#MainExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\7zip-gui.exe\shell\open\command" Type="string" Value="&quot;[#MainExe]&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.7z\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.zip\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rar\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tar\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gz\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tgz\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bz2\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.xz\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.zst\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iso\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.cab\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wim\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.001\OpenWithProgids" Name="SevenZipGui.Archive" Type="string" Value="" />
      </Component>

      <!-- Tells the in-app updater that this copy updates through MSI. -->
      <Component Id="InstallKind" Guid="*">
        <File Id="InstallKindFile" Source="$(Stage)\install-kind" Name="install-kind" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="7zip-GUI" Level="1">
      <ComponentGroupRef Id="Application" />
    </Feature>
  </Package>
</Wix>
