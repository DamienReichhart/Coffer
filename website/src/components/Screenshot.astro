---
/*
 * A screenshot of the app in the visitor's theme. Shots are rendered headlessly
 * by the app itself (`npm run screenshots`, the `screenshots` example of
 * crates/app) into src/assets/screenshots/{light,dark}/<name>.png at 1280×800
 * and a scale factor of 2, and regenerated on every deployment. They are not
 * committed: without them (a fresh checkout) a neutral placeholder is shown.
 *
 * Served as AVIF with a WebP fallback at the widths below, up to the shot's own.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

export type ScreenshotName =
  | 'welcome'
  | 'browse'
  | 'compress'
  | 'extract'
  | 'activity'
  | 'checksums'
  | 'settings';

const WIDTHS = [640, 960, 1280, 1600, 1920, 2560];
const QUALITY = { avif: 70, webp: 90 } as const;

interface Props {
  name: ScreenshotName;
  alt: string;
  /** How wide the shot is drawn, as `<img sizes>`. */
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { name, alt, sizes, eager = false } = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*/*.png', {
  eager: true,
});
const find = (theme: string) => shots[`/src/assets/screenshots/${theme}/${name}.png`]?.default;
const dark = find('dark');
const light = find('light');

const variants: { image: ImageMetadata; theme: string }[] =
  dark && light
    ? [
        { image: dark, theme: 'only-dark' },
        { image: light, theme: 'only-light' },
      ]
    : [dark ?? light].filter((i) => i !== undefined).map((image) => ({ image, theme: '' }));

if (variants.length === 0) console.warn(`[screenshot] missing src/assets/screenshots/*/${name}.png`);

const pictures = await Promise.all(
  variants.map(async ({ image, theme }) => {
    const widths = WIDTHS.filter((w) => w <= image.width);
    const [avif, webp] = await Promise.all(
      (['avif', 'webp'] as const).map((format) =>
        getImage({ src: image, format, widths, quality: QUALITY[format] }),
      ),
    );
    return { avif: avif!, webp: webp!, theme };
  }),
);
---

{
  pictures.length > 0 ? (
    <div class:list={['window', Astro.props.class]}>
      {pictures.map(({ avif, webp, theme }) => (
        <picture>
          <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
          <img
            src={webp.src}
            srcset={webp.srcSet.attribute}
            sizes={sizes}
            alt={alt}
            class={theme || undefined}
            width={webp.attributes.width}
            height={webp.attributes.height}
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
          />
        </picture>
      ))}
    </div>
  ) : (
    <div class:list={['window', 'window--placeholder', Astro.props.class]} role="img" aria-label={alt}>
      <span>{alt}</span>
    </div>
  )
}
