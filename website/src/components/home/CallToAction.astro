---
import DownloadButton from '@/components/DownloadButton.astro';
import Icon from '@/components/Icon.astro';
import { REPO_URL } from '@/lib/site';
---

<section class="section cta">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} alt="" width="72" height="72" />
      <h2>Give your archives a better home.</h2>
      <p>Free and open source. Bring your own 7-Zip, and you’re ready in a minute.</p>
      <div class="cta__actions">
        <DownloadButton />
        <a class="button button--secondary button--large" href={REPO_URL}>
          <Icon name="github" />
          View on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-bottom: 0;
  }
  .cta__panel {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding: 4rem 1.5rem;
    border: 1px solid var(--z-border);
    border-radius: 1.25rem;
    background:
      radial-gradient(ellipse 60% 80% at 50% 0%, var(--z-glow), transparent 70%),
      var(--z-surface);
    text-align: center;
  }
  .cta__panel h2 {
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
  }
  .cta__panel p {
    color: var(--z-text-muted);
    font-size: 1.1rem;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
