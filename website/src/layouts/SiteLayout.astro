---
/*
 * Layout for the marketing pages (home, download, changelog, legal, 404). The
 * docs use Starlight's own layout; both share the palette in styles/theme.css
 * and the theme the visitor picked (localStorage `starlight-theme`).
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/theme.css';
import '@/styles/site.css';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { DESCRIPTION, NAME, REPO_URL } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  /** Structured data (JSON-LD) for search engines. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, jsonLd, noindex = false } = Astro.props;
const description = Astro.props.description ?? DESCRIPTION;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121316" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${NAME} — a modern desktop app for 7-Zip`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="me" href={REPO_URL} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Apply the stored or system theme before first paint, the same way Starlight does. */}
    <script is:inline>
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {
          // Storage can be unavailable (private mode): follow the system.
        }
        if (stored === 'auto') stored = '';
        const light = matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = stored || (light ? 'light' : 'dark');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('reveal-ready');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Fade sections in as they scroll into view.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && document.documentElement.classList.contains('reveal-ready')) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const item of items) observer.observe(item);
      } else {
        for (const item of items) item.classList.add('is-visible');
      }
    </script>
  </body>
</html>
